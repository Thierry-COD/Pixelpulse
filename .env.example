# Copia este archivo como ".env" y completa tus datos reales.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Motor de base de datos: mysql  |  sqlsrv
DB_DRIVER=mysql

# Servidor. Para SQL Server con instancia: localhost\SQLEXPRESS
DB_HOST=localhost
# Puerto (opcional). MySQL: 3306. SQL Server: 1433. Déjalo vacío si usas instancia con nombre.
DB_PORT=3306
DB_NAME=PA3_PIXELPULSE
# Usuario y clave (en SQL Server con autenticación de Windows, déjalos vacíos)
DB_USER=root
DB_PASS=

# Origen permitido para CORS (* = cualquiera; en producción pon tu dominio)
CORS_ORIGIN=*

# true muestra el detalle técnico del error en la respuesta (solo para desarrollo)
APP_DEBUG=false
        